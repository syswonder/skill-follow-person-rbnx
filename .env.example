# Copy to .env. Never commit the resulting .env file.

# ---- Ranger chassis CAN (optional; defaults are the Ranger Mini v3 values) ----
# The follow stack owns the can_ranger bus. It must not run at the same time as
# the navigation stack. Override only if this host uses a different CAN name.
# RANGER_CAN_INTERFACE=can_ranger
# RANGER_CAN_BITRATE=500000

# ---- MiniCPM-RobotTrack inference server (optional; defaults are in the
#      start_robottrack_inference_server.sh script) ----
# Model tree lives OUTSIDE the container at <repo>/upstream/MiniCPM-Robot and is
# mounted in at runtime.  These exist to override that pin without editing the
# script.
# ROBOTTRACK_UPSTREAM_ROOT=/abs/path/to/MiniCPM-Robot
# ROBOTTRACK_PYTHON=/root/minicpm-infer-venv/bin/python
# ROBOTTRACK_SERVER_HOST=127.0.0.1
# ROBOTTRACK_SERVER_PORT=5801
# ROBOTTRACK_DEVICE=cuda:0
# ROBOTTRACK_INSTRUCTION=Follow the person ahead
