# Copy to .env. Never commit the resulting .env file.

# ---- Ranger chassis CAN (optional; defaults are the Ranger Mini v3 values) ----
# The follow stack owns the can_ranger bus. It must not run at the same time as
# the navigation stack. Override only if this host uses a different CAN name.
# RANGER_CAN_INTERFACE=can_ranger
# RANGER_CAN_BITRATE=500000

# ---- Mid-360 lidar (required by the mapping + Nav2 services) ----
LIDAR_IP=192.168.1.112

# ---- MiniCPM-RobotTrack inference server (optional; defaults are in the
#      start_robottrack_inference_server.sh script) ----
# Model tree lives OUTSIDE the container at <repo>/upstream/MiniCPM-Robot and is
# mounted in at runtime.  These exist to override that pin without editing the
# script.
# ROBOTTRACK_UPSTREAM_ROOT=/abs/path/to/MiniCPM-Robot
# ROBOTTRACK_PYTHON=/usr/bin/python3
# ROBOTTRACK_SERVER_HOST=127.0.0.1
# ROBOTTRACK_SERVER_PORT=5801
# ROBOTTRACK_DEVICE=cuda:0
# ROBOTTRACK_INSTRUCTION=Follow the person ahead
# ROBOTTRACK_TARGET_DISTANCE_M=5.0
#
# Vision backends (DINOv3 + SigLIP).  Default is the on-device TensorRT 10.7
# FP16 engines; `torch` is the Go2 reference's fallback and the one-line
# rollback.  Mixed values are allowed through the two per-tower variables.
# Setting it here is the durable way: the file is sourced INSIDE the container.
# `ROBOTTRACK_VISION_BACKEND=torch bash scripts/follow.sh start` also works (it
# forwards the variable).  Exporting it and calling docker exec by hand does
# not -- docker exec never inherits the host shell's environment.
#   ROBOTTRACK_VISION_BACKEND=torch        # both towers back to torch
#   ROBOTTRACK_DINO_BACKEND=trt_direct
#   ROBOTTRACK_SIGLIP_BACKEND=trt_direct

# ---- Robonix Pilot "VLM" = the local follow-distance intent router ----
# Pilot is told to use an OpenAI-compatible endpoint; this deployment points it
# at packages/semantic_intent_router, which maps one bounded Chinese utterance
# onto one follow_distance capability call.  The API key is never used by the
# router but Pilot requires a non-empty value.
SEMANTIC_INTENT_HOST=127.0.0.1
SEMANTIC_INTENT_PORT=18080
VLM_BASE_URL=http://127.0.0.1:18080/v1
VLM_API_KEY=local-no-secret
VLM_MODEL=ranger-follow-distance-router
# The router's mode is NOT set here.  scripts/start_follow.sh derives it from
# the manifest's go2_robottrack `mode:` so the two can never disagree: a live
# stack with a preview router would recognize "靠近一点" and then refuse to act
# on it.  Use scripts/set_follow_mode.sh to switch both at once.

# ---- Tencent Cloud speech (ASR for voice commands, TTS for replies) ----
# Supplied only through this environment; never written into the manifest.
TENCENT_ASR_APPID=
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=

# Host-side address of the lidar ethernet port. The navigation deployment
# expects 192.168.1.50 (its setup-hw.sh sets it); set this if the interface
# currently holds a different address.
# LIDAR_HOST_IP=192.168.1.50
