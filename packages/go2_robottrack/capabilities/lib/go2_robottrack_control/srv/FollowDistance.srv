# operation: "set", "adjust", "get", "lock", or "unlock".  For "adjust", meters
# is a signed delta.  "get" ignores meters.  "lock" enrolls the person nearest
# the camera as the one person to follow (specified-person lock); "unlock"
# forgets them and restores ordinary following.  "lock"/"unlock" ignore meters
# and are rejected with accepted=false when the deployment has the lock disabled
# or its re-identification model unavailable.
string operation
float64 meters
---
bool accepted
bool enabled
bool active
bool has_measurement
float64 target_distance_m
float64 measured_distance_m
string status
string detail
